{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GC Console",
  "version": "0.1.0",
  "identifier": "dev.gc.console",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://127.0.0.1:3131",
    "beforeDevCommand": "npm run prepare:tauri && npm run dev",
    "beforeBuildCommand": "npm run prepare:tauri && npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/node-sidecar"
    ],
    "resources": [
      "../dist/**/*",
      "../public/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
