# Developer ID signing identity.
# Example: APPLE_SIGNING_IDENTITY=Developer ID Application: Your Name (TEAMID)
APPLE_SIGNING_IDENTITY=

# Preferred notarization mode: App Store Connect API key
APPLE_API_ISSUER=
APPLE_API_KEY=
APPLE_API_KEY_PATH=

# Alternative notarization mode: Apple ID + app-specific password
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
